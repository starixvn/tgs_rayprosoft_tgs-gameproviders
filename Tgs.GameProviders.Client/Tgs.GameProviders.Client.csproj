<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.54</Version>
		<Authors>Raypro</Authors>
		<Description>TGS Game Providers Client</Description>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameproviders</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameproviders.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>tgs-gameproviders</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="7.0.1" />
		<PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.2" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Tgs.GameProviders.Domains\Tgs.GameProviders.Domains.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>
</Project>
